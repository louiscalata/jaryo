  "fontFamily": {
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "JetBrains Mono",
        "Menlo",
        "DejaVu Sans Mono",
        "ui-monospace",
        "monospace"
      ]
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "Inter",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "font-machine": {
      "$type": "fontFamily",
      "$value": "{fontFamily.mono}"
    },
    "font-reading": {
      "$type": "fontFamily",
      "$value": "{fontFamily.sans}"
    },
    "font-display": {
      "$type": "fontFamily",
      "$value": "{fontFamily.mono}"
    },
    "font-serif-study": {
      "$type": "fontFamily",
      "$value": [
        "Libre Baskerville",
        "Iowan Old Style",
        "Palatino Linotype",
        "Palatino",
        "serif"
      ]
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.font-reading}",
        "fontSize": "{dimension.fs-3}",
        "fontWeight": "{fontWeight.regular}",
        "letterSpacing": "{dimension.track-body}",
        "lineHeight": 1.5
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.font-reading}",
        "fontSize": "{dimension.fs-4}",
        "fontWeight": "{fontWeight.bold}",
        "letterSpacing": "{dimension.track-display-tight}",
        "lineHeight": 1.2
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.font-display}",
        "fontSize": "{dimension.fs-6}",
        "fontWeight": "{fontWeight.bold}",
        "letterSpacing": "{dimension.track-display}",
        "lineHeight": 1.2
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.font-machine}",
        "fontSize": "{dimension.fs-1}",
        "fontWeight": "{fontWeight.semibold}",
